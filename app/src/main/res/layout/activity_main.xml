<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <!-- profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/profile_background"
                android:padding="16dp">

                <TextView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:gravity="center"
                    android:text="SJ"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:background="@drawable/avatar_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sarah Johnson"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Administrator"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Account -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account Information"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/card_background">

                <!-- email -->
                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:gravity="center_vertical"
                    android:text="✉   Email\n      sarah@school.edu"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:background="@drawable/item_background"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- phone -->
                <TextView
                    android:id="@+id/txtPhone"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:text="☎   Phone\n      +1 (555) 987-6547"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:background="@drawable/item_background"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- institution -->
                <TextView
                    android:id="@+id/txtInstitution"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:text="▣   Institution\n      University of Oxford"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:background="@drawable/item_background" />

                <!-- role -->
                <TextView
                    android:id="@+id/txtRole"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:text="♢   Role\n      Admin"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:background="@drawable/item_background"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- notification -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:text="♧   Push Notification\n      Receive alerts on your device"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="✉   Email Notification\n      Receive updates via email"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#181818">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌖\nMap"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nManage"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▥\nReport"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#7C5CFF"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>